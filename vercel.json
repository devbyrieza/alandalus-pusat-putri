{
  "name": "alandalus-pusat-putri",

  "env": {
    "NEXT_PUBLIC_APP_NAME": "Al-Andalus Pusat Putri",
    "NEXT_PUBLIC_APP_DESCRIPTION": "Website Resmi Al-Andalus Pusat Putri"
  },
  "regions": ["sin1"],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}

